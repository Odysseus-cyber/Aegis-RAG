# Ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=gemma3:1b
EMBED_MODEL=nomic-embed-text

# ChromaDB
# "local" uses PersistentClient (no Docker needed); "http" connects to a running server
CHROMA_MODE=local
CHROMA_LOCAL_PATH=.chroma
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_AUTH_TOKEN=
CHROMA_COLLECTION=aegis_rag_documents

# Telemetry
TELEMETRY_DB_PATH=telemetry.db

# App
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173

# Grafana (development Compose): placeholder for configuration validation only.
# Replace it with a private random password in .env before starting services.
# Published demo deployments generate a separate private password automatically.
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_PRIVATE_RANDOM_PASSWORD
